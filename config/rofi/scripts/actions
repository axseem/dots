#!/usr/bin/env bash

set -u

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
SCREENSHOT_DIR=${SCREENSHOT_DIR:-$HOME/me/screenshots}

confirm() {
    local label=$1 choice
    choice=$(printf 'Cancel\n%s\n' "$label" |
        rofi -dmenu -p "Confirm" -no-custom -no-auto-select -selected-row 0) || return 1
    [[ $choice == "$label" ]]
}

worker() {
    local action=$1 selected geometry file
    sleep 0.15 # Let the parent rofi release its keyboard grab.

    case $action in
        wifi) networkmanager_dmenu -no-auto-select ;;
        bluetooth) "$SCRIPT_DIR/bluetooth" ;;
        audio) pavucontrol ;;
        files) nautilus ;;
        emoji) rofi -show emoji ;;
        clipboard)
            selected=$(cliphist list | rofi -dmenu -p "Clipboard" -no-custom -no-auto-select) || return
            printf '%s' "$selected" | cliphist decode | wl-copy
            ;;
        screenshot-area)
            geometry=$(slurp) || return
            mkdir -p "$SCREENSHOT_DIR"
            file="$SCREENSHOT_DIR/$(date +'%Y-%m-%d_%H-%M-%S').png"
            grim -g "$geometry" - | tee "$file" | wl-copy
            ;;
        screenshot-full)
            mkdir -p "$SCREENSHOT_DIR"
            file="$SCREENSHOT_DIR/$(date +'%Y-%m-%d_%H-%M-%S').png"
            grim - | tee "$file" | wl-copy
            ;;
        lock) bash -c "${LOCK_CMD:-swaylock -f}" ;;
        suspend)
            confirm "Suspend" && systemctl suspend
            ;;
        logout)
            if confirm "Log out"; then
                if [[ -n ${XDG_SESSION_ID:-} ]]; then
                    loginctl terminate-session "$XDG_SESSION_ID"
                elif [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
                    hyprctl dispatch exit
                else
                    pkill -TERM -x dwl
                fi
            fi
            ;;
        reboot)
            confirm "Restart" && systemctl reboot
            ;;
        poweroff)
            confirm "Power off" && systemctl poweroff
            ;;
    esac
}

if [[ ${1:-} == --worker ]]; then
    worker "${2:?missing action}"
    exit
fi

row() {
    local label=$1 icon=$2 action=$3 terms=$4
    printf '%s\0icon\x1f%s\x1finfo\x1f%s\x1fmeta\x1f%s\n' \
        "$label" "$icon" "$action" "$terms"
}

if [[ ${ROFI_RETV:-0} == 0 ]]; then
    printf '\0no-custom\x1ftrue\n'
    row "Wi-Fi settings" "network-wireless-symbolic" "wifi" "network internet wireless"
    row "Bluetooth settings" "bluetooth-symbolic" "bluetooth" "devices connect headphones"
    row "Audio settings" "audio-volume-high-symbolic" "audio" "sound volume microphone"
    row "Clipboard history" "edit-paste-symbolic" "clipboard" "copy paste cliphist"
    row "Browse files" "folder-symbolic" "files" "file manager nautilus folders"
    row "Emoji picker" "face-smile-symbolic" "emoji" "symbols characters"
    row "Screenshot area" "camera-photo-symbolic" "screenshot-area" "capture selection snip"
    row "Screenshot full screen" "camera-photo-symbolic" "screenshot-full" "capture monitor display"
    row "Lock screen" "system-lock-screen-symbolic" "lock" "secure swaylock"
    row "Suspend" "media-playback-pause-symbolic" "suspend" "sleep power"
    row "Log out" "system-log-out-symbolic" "logout" "exit session"
    row "Restart" "system-reboot-symbolic" "reboot" "reboot power"
    row "Power off" "system-shutdown-symbolic" "poweroff" "shutdown turn off"
    exit
fi

if [[ ${ROFI_RETV:-0} == 1 && -n ${ROFI_INFO:-} ]]; then
    coproc {
        env -u ROFI_RETV -u ROFI_INFO -u ROFI_DATA \
            "$0" --worker "$ROFI_INFO" >/dev/null 2>&1
    }
fi
