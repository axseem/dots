#!/usr/bin/env bash

# A small BlueZ menu. State is read over D-Bus because bluetoothctl can return
# incomplete output when it is used non-interactively; actions still use the
# supported bluetoothctl interface.
set -u

THEME=axseem

menu() {
    local prompt=$1
    shift
    rofi -dmenu -theme "$THEME" -p "$prompt" -no-custom -no-auto-select "$@"
}

adapter_path() {
    busctl tree org.bluez --list 2>/dev/null |
        grep -m1 -E '^/org/bluez/hci[0-9]+$' || true
}

ADAPTER_PATH=$(adapter_path)

if [[ -z $ADAPTER_PATH ]]; then
    printf 'No Bluetooth adapter found\n' | menu "Bluetooth" >/dev/null
    exit
fi

adapter_prop() {
    busctl get-property org.bluez "$ADAPTER_PATH" org.bluez.Adapter1 "$1" 2>/dev/null
}

device_prop() {
    busctl get-property org.bluez "$1" org.bluez.Device1 "$2" 2>/dev/null
}

is_true() {
    grep -q '^b true$'
}

string_value() {
    sed -E 's/^s "(.*)"$/\1/'
}

powered() {
    adapter_prop Powered | is_true
}

device_rows() {
    local path mac name state
    while IFS= read -r path; do
        [[ -n $path ]] || continue
        mac=${path##*/dev_}
        mac=${mac//_/:}
        name=$(device_prop "$path" Alias | string_value)
        [[ -n $name ]] || name=$mac

        state=""
        if device_prop "$path" Connected | is_true; then
            state="connected"
        elif device_prop "$path" Paired | is_true; then
            state="paired"
        fi
        printf '%s\t%s\t%s\n' "$name" "$mac" "$state"
    done < <(
        busctl tree org.bluez --list 2>/dev/null |
            grep -E "^${ADAPTER_PATH}/dev_[0-9A-Fa-f_]+$" |
            sort -u
    )
}

device_path() {
    printf '%s/dev_%s' "$ADAPTER_PATH" "${1//:/_}"
}

device_menu() {
    local mac=$1 path name connected paired trusted choice action
    path=$(device_path "$mac")

    while true; do
        name=$(device_prop "$path" Alias | string_value)
        device_prop "$path" Connected | is_true && connected=true || connected=false
        device_prop "$path" Paired | is_true && paired=true || paired=false
        device_prop "$path" Trusted | is_true && trusted=true || trusted=false

        $connected && action="Disconnect" || action="Connect"
        choice=$(
            {
                printf '%s\n' "$action"
                $paired && printf 'Remove pairing\n' || printf 'Pair\n'
                $trusted && printf 'Untrust\n' || printf 'Trust\n'
                printf 'Back\n'
            } | menu "$name"
        ) || return

        case $choice in
            Connect) bluetoothctl connect "$mac" >/dev/null ;;
            Disconnect) bluetoothctl disconnect "$mac" >/dev/null ;;
            Pair) bluetoothctl pair "$mac" >/dev/null ;;
            "Remove pairing") bluetoothctl remove "$mac" >/dev/null; return ;;
            Trust) bluetoothctl trust "$mac" >/dev/null ;;
            Untrust) bluetoothctl untrust "$mac" >/dev/null ;;
            Back) return ;;
        esac
    done
}

while true; do
    if ! powered; then
        choice=$(printf 'Turn Bluetooth on\t@power\t\n' |
            menu "Bluetooth" -display-columns 1,3 -display-column-separator '\t') || exit
        if [[ $choice == *$'\t@power\t'* ]]; then
            command -v rfkill >/dev/null && rfkill unblock bluetooth
            bluetoothctl power on >/dev/null
        fi
        continue
    fi

    choice=$(
        {
            device_rows
            printf 'Scan for devices\t@scan\t\n'
            printf 'Turn Bluetooth off\t@power\t\n'
        } | menu "Bluetooth" -display-columns 1,3 -display-column-separator '\t'
    ) || exit

    IFS=$'\t' read -r _ id _ <<<"$choice"
    case $id in
        @scan) bluetoothctl --timeout 8 scan on >/dev/null ;;
        @power) bluetoothctl power off >/dev/null ;;
        "") ;;
        *) device_menu "$id" ;;
    esac
done
